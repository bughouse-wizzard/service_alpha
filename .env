# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=service_alpha
DB_HOST=db
DB_PORT=5432
DB_URL=postgresql://postgres:postgres@db:5432/service_alpha

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# API Keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Application Settings
LOG_LEVEL=INFO
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0